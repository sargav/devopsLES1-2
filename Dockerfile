#
FROM node:24-alpine
# (cd כמו) תיקיית העבודה בתוך הקונטיינר 2. #
WORKDIR /app
# קודם מעתיקים רק את קבצי התלויות 3. #
COPY package*.json ./
# מתקינים תלויות) רץ בזמן הבנייה( 4. #
RUN npm install
# ועכשיו מעתיקים את כל שאר הקוד 5. #
COPY . .
# תיעוד: האפליקציה מאזינה בפורט 3000 6. 
EXPOSE 3000
# הפקודה שרצה כשהקונטיינר עולה 7. 
CMD ["node", "server.js"]